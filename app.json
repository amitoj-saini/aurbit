{
  "expo": {
    "name": "Aurbit",
    "slug": "Aurbit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/app-logo.png",
    "scheme": "aurbit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/logo/app-logo.png",
      "bundleIdentifier": "com.amitoj.aurbit",
      "infoPlist": {
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "icon": "./assets/logo/app-logo.png",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.aurbit"
    },
    "web": {
      "output": "static",
      "favicon": "./assests/images/aurbit.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
